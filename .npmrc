# npm 镜像配置（国内加速）
registry=https://registry.npmmirror.com

# better-sqlite3 原生二进制镜像（国内 CDN）
better_sqlite3_binary_host_mirror=https://cdn.npmmirror.com/binaries/better-sqlite3

# 增加超时和重试（vite 元数据较大）
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# 使用独立缓存目录（避免之前的缓存损坏）
cache=C:/Users/19825/Desktop/npm-cache-fresh

# 网络代理（可选，如需要）
# https-proxy=http://127.0.0.1:7890
# http-proxy=http://127.0.0.1:7890
